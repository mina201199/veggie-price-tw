# Copy to deploy/backend.env; never commit backend.env.
# Real DNS name pointing to the deployment server (no scheme/path/port).
BACKEND_DOMAIN=ledger.example.com
# Generate a new secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-generated-secret
# Use a separate random 48+ character URL-safe password (letters/digits/_/-).
POSTGRES_PASSWORD=replace-with-generated-password

# Optional: change all three together if this subnet conflicts with your host.
PROXY_SUBNET=172.30.88.0/24
CADDY_INTERNAL_IP=172.30.88.10
APP_INTERNAL_IP=172.30.88.20
